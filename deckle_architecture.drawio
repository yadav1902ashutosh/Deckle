        <mxCell id="rel_v_to_c" value="&lt;b&gt;1 : N&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#0C8599;" edge="1" parent="1" source="tbl_volumes" target="tbl_chapters">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- TABLE 6: USER_BOOKSHELF -->
        <mxCell id="tbl_shelf" value="&lt;b style=&quot;font-size: 15px; color: #C92A2A;&quot;&gt;user_bookshelf (Library)&lt;/b&gt;&lt;hr style=&quot;border: 0; border-top: 1px solid #FFA8A8; margin: 4px 0;&quot;&gt;&lt;div style=&quot;text-align: left; font-family: monospace; font-size: 11px; line-height: 1.6; color: #212529;&quot;&gt;&lt;b style=&quot;color: #E03131;&quot;&gt;🔑 id&lt;/b&gt; : SERIAL (PK)&lt;br&gt;&lt;b style=&quot;color: #1971C2;&quot;&gt;🔗 user_id&lt;/b&gt; : INT (FK → users)&lt;br&gt;&lt;b style=&quot;color: #E67700;&quot;&gt;🔗 book_id&lt;/b&gt; : INT (FK → books)&lt;br&gt;&lt;b&gt;• folder&lt;/b&gt; : VARCHAR(50) [all, favs]&lt;br&gt;&lt;b&gt;• is_favorite&lt;/b&gt; : BOOLEAN&lt;br&gt;&lt;b&gt;• unread_chapters_count&lt;/b&gt; : INT&lt;br&gt;&lt;b&gt;• last_accessed_at&lt;/b&gt; : TIMESTAMP&lt;br&gt;&lt;span style=&quot;color: #C92A2A;&quot;&gt;⭐ UNIQUE(user_id, book_id)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#E03131;strokeWidth=2;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="820" width="280" height="230" as="geometry" />
        </mxCell>

        <!-- TABLE 7: READING_HISTORY -->
        <mxCell id="tbl_history" value="&lt;b style=&quot;font-size: 15px; color: #0B7285;&quot;&gt;reading_history (Progress)&lt;/b&gt;&lt;hr style=&quot;border: 0; border-top: 1px solid #66D9E8; margin: 4px 0;&quot;&gt;&lt;div style=&quot;text-align: left; font-family: monospace; font-size: 11px; line-height: 1.6; color: #212529;&quot;&gt;&lt;b style=&quot;color: #E03131;&quot;&gt;🔑 id&lt;/b&gt; : SERIAL (PK)&lt;br&gt;&lt;b style=&quot;color: #1971C2;&quot;&gt;🔗 user_id&lt;/b&gt; : INT (FK → users)&lt;br&gt;&lt;b style=&quot;color: #E67700;&quot;&gt;🔗 book_id&lt;/b&gt; : INT (FK → books)&lt;br&gt;&lt;b style=&quot;color: #2B8A3E;&quot;&gt;🔗 chapter_id&lt;/b&gt; : INT (FK → chapters)&lt;br&gt;&lt;b&gt;• chapter_number&lt;/b&gt; : INTEGER&lt;br&gt;&lt;b&gt;• scroll_percentage&lt;/b&gt; : DECIMAL(5,2)&lt;br&gt;&lt;b&gt;• words_read&lt;/b&gt; : INTEGER&lt;br&gt;&lt;b&gt;• last_read_at&lt;/b&gt; : TIMESTAMP&lt;br&gt;&lt;span style=&quot;color: #0B7285;&quot;&gt;⭐ UNIQUE(user_id, book_id)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FAFC;strokeColor=#0C8599;strokeWidth=2;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="500" y="820" width="310" height="240" as="geometry" />
        </mxCell>

        <!-- TABLE 8: CHAPTER_LORE -->
        <mxCell id="tbl_lore" value="&lt;b style=&quot;font-size: 15px; color: #D9480F;&quot;&gt;chapter_lore (Lexicon)&lt;/b&gt;&lt;hr style=&quot;border: 0; border-top: 1px solid #FFC078; margin: 4px 0;&quot;&gt;&lt;div style=&quot;text-align: left; font-family: monospace; font-size: 11px; line-height: 1.6; color: #212529;&quot;&gt;&lt;b style=&quot;color: #E03131;&quot;&gt;🔑 id&lt;/b&gt; : SERIAL (PK)&lt;br&gt;&lt;b style=&quot;color: #E67700;&quot;&gt;🔗 book_id&lt;/b&gt; : INT (FK → books)&lt;br&gt;&lt;b&gt;• term&lt;/b&gt; : VARCHAR(100)&lt;br&gt;&lt;b&gt;• definition&lt;/b&gt; : TEXT&lt;br&gt;&lt;b&gt;• created_at&lt;/b&gt; : TIMESTAMP&lt;br&gt;&lt;i style=&quot;color: #D9480F;&quot;&gt;⭐ Hoverable Xianxia/Lore Tooltips&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E6;strokeColor=#D9480F;strokeWidth=2;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="930" y="820" width="270" height="200" as="geometry" />
        </mxCell>

        <!-- Secondary Relational Connectors -->
        <mxCell id="edge_u_to_shelf" value="&lt;b&gt;bookmarks&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#E03131;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="tbl_users" target="tbl_shelf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="edge_u_to_hist" value="&lt;b&gt;syncs progress&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#0C8599;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="tbl_users" target="tbl_history">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="210" y="770" />
              <mxPoint x="562" y="770" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="edge_b_to_lore" value="&lt;b&gt;glossary&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#D9480F;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="tbl_books" target="tbl_lore">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
