        <mxCell id="rel_p_to_b" value="&lt;b&gt;1 : N&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#7048E8;" edge="1" parent="1" source="tbl_personas" target="tbl_books">
          <mxGeometry relative="1" as="geometry" />
