<mxfile host="app.diagrams.net" modified="2026-10-03T18:35:00.000Z" agent="Deckle Architect" version="24.0.0">
  <diagram id="deckle-diagram" name="Deckle Full-Stack Architecture &amp; ERD">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" background="#F8F9FA" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ============================================================== -->
        <!-- 1. TITLE BANNER -->
        <!-- ============================================================== -->
        <mxCell id="title_banner" value="&lt;b style=&quot;font-size: 24px; color: #8B2635;&quot;&gt;DECKLE — System Architecture &amp;amp; Relational Data Model&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 14px; color: #57534E;&quot;&gt;5-Tier Webnovel Hierarchy: Users → Personas → Books → Volumes → Chapters | Netlify + Render + Neon PostgreSQL&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8F5;strokeColor=#8B2635;strokeWidth=2;align=left;spacingLeft=30;" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="1680" height="80" as="geometry" />
        </mxCell>

        <!-- ============================================================== -->
        <!-- 2. CLOUD INFRASTRUCTURE & TOPOLOGY CONTAINER -->
        <!-- ============================================================== -->
        <mxCell id="infra_group" value="&lt;b style=&quot;font-size: 13px; color: #495057;&quot;&gt;CLOUD DEPLOYMENT &amp;amp; RUNTIME TOPOLOGY&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CED4DA;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=20;spacingTop=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="1680" height="230" as="geometry" />
        </mxCell>

        <!-- Node: Netlify Frontend -->
        <mxCell id="node_netlify" value="&lt;b style=&quot;font-size: 16px; color: #1864AB;&quot;&gt;🖥️ Client SPA (Netlify)&lt;/b&gt;&lt;hr style=&quot;border: 0; border-top: 1px solid #74C0FC; margin: 6px 0;&quot;&gt;&lt;div style=&quot;text-align: left; font-size: 12px; line-height: 1.5; color: #343A40;&quot;&gt;• React 19 + Vite Engine&lt;br&gt;• Tailwind CSS 4 + Typography&lt;br&gt;• Redux Toolkit Auth Slice&lt;br&gt;• Instant Theme Preloader&lt;br&gt;• Cross-Domain Token Fallback&lt;br&gt;• Base URL: VITE_API_BASE_URL&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5FF;strokeColor=#1971C2;strokeWidth=2;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="190" width="280" height="160" as="geometry" />
        </mxCell>

        <!-- Node: Render Backend -->
        <mxCell id="node_render" value="&lt;b style=&quot;font-size: 16px; color: #5F3DC4;&quot;&gt;⚡ Backend API (Render)&lt;/b&gt;&lt;hr style=&quot;border: 0; border-top: 1px solid #B197FC; margin: 6px 0;&quot;&gt;&lt;div style=&quot;text-align: left; font-size: 12px; line-height: 1.5; color: #343A40;&quot;&gt;• Express.js REST Service&lt;br&gt;• Trust Proxy: 1 (HTTPS SSL)&lt;br&gt;• Multi-Origin CORS Whitelist&lt;br&gt;• Dual Auth (Cookies + Header)&lt;br&gt;• 5-Tier Ownership Checks&lt;br&gt;• Host Binding: 0.0.0.0:$PORT&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F0FF;strokeColor=#7048E8;strokeWidth=2;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="190" width="300" height="160" as="geometry" />
        </mxCell>

        <!-- Node: Neon Database -->
        <mxCell id="node_neon" value="&lt;b style=&quot;font-size: 16px; color: #2B8A3E;&quot;&gt;🐘 Database (Neon DB)&lt;/b&gt;&lt;hr style=&quot;border: 0; border-top: 1px solid #8CE99A; margin: 6px 0;&quot;&gt;&lt;div style=&quot;text-align: left; font-size: 12px; line-height: 1.5; color: #343A40;&quot;&gt;• Serverless PostgreSQL 16&lt;br&gt;• Tagged Template Protocol&lt;br&gt;• Prepared Statement Safe&lt;br&gt;• Cascading Foreign Keys&lt;br&gt;• Connection Pooling Engine&lt;br&gt;• SSL Mode: require&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBFBEE;strokeColor=#2F9E44;strokeWidth=2;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1000" y="190" width="280" height="160" as="geometry" />
        </mxCell>

        <!-- Node: Cloudinary CDN -->
        <mxCell id="node_cloudinary" value="&lt;b style=&quot;font-size: 16px; color: #E67700;&quot;&gt;☁️ Media CDN (Cloudinary)&lt;/b&gt;&lt;hr style=&quot;border: 0; border-top: 1px solid #FFE066; margin: 6px 0;&quot;&gt;&lt;div style=&quot;text-align: left; font-size: 12px; line-height: 1.5; color: #343A40;&quot;&gt;• Book &amp;amp; Volume Covers (2:3)&lt;br&gt;• Pen Name Avatars&lt;br&gt;• Wide Header Banners&lt;br&gt;• Auto Format &amp;amp; WebP Delivery&lt;br&gt;• Multer Stream Uploads&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#F08C00;strokeWidth=2;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1420" y="190" width="280" height="160" as="geometry" />
        </mxCell>

        <!-- Infrastructure Connectors -->
        <mxCell id="edge_net_to_ren" value="&lt;b style=&quot;font-size: 11px; color: #5F3DC4;&quot;&gt;REST API + JWT&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#7048E8;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="node_netlify" target="node_render">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="edge_ren_to_neon" value="&lt;b style=&quot;font-size: 11px; color: #2B8A3E;&quot;&gt;SQL Queries (Pool)&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#2F9E44;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="node_render" target="node_neon">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="edge_ren_to_cloud" value="&lt;b style=&quot;font-size: 11px; color: #E67700;&quot;&gt;Multer Streams&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#F08C00;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="node_render" target="node_cloudinary">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="840" y="320" />
              <mxPoint x="1360" y="320" />
              <mxPoint x="1360" y="270" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ============================================================== -->
        <!-- 3. DATABASE ERD (5-TIER HIERARCHY) CONTAINER -->
        <!-- ============================================================== -->
        <mxCell id="erd_group" value="&lt;b style=&quot;font-size: 13px; color: #495057;&quot;&gt;RELATIONAL DATABASE SCHEMA (5-TIER HIERARCHY + READING ENGINE)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CED4DA;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=20;spacingTop=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="410" width="1680" height="740" as="geometry" />
        </mxCell>

        <!-- TABLE 1: USERS -->
        <mxCell id="tbl_users" value="&lt;b style=&quot;font-size: 15px; color: #1864AB;&quot;&gt;users&lt;/b&gt;&lt;hr style=&quot;border: 0; border-top: 1px solid #74C0FC; margin: 4px 0;&quot;&gt;&lt;div style=&quot;text-align: left; font-family: monospace; font-size: 11px; line-height: 1.6; color: #212529;&quot;&gt;&lt;b style=&quot;color: #E03131;&quot;&gt;🔑 id&lt;/b&gt; : SERIAL (PK)&lt;br&gt;&lt;b&gt;• username&lt;/b&gt; : VARCHAR(50) [UQ]&lt;br&gt;&lt;b&gt;• email&lt;/b&gt; : VARCHAR(100) [UQ]&lt;br&gt;&lt;b&gt;• password&lt;/b&gt; : VARCHAR(255)&lt;br&gt;&lt;b&gt;• full_name&lt;/b&gt; : VARCHAR(100) NULL&lt;br&gt;&lt;b&gt;• role&lt;/b&gt; : reader | writer | admin&lt;br&gt;&lt;b&gt;• reading_preferences&lt;/b&gt; : JSONB&lt;br&gt;&lt;b&gt;• streak_days&lt;/b&gt; : INTEGER&lt;br&gt;&lt;b&gt;• refresh_token&lt;/b&gt; : TEXT&lt;br&gt;&lt;b&gt;• created_at&lt;/b&gt; : TIMESTAMP&lt;br&gt;&lt;b&gt;• deleted_at&lt;/b&gt; : TIMESTAMP&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5FF;strokeColor=#1971C2;strokeWidth=2;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="460" width="240" height="260" as="geometry" />
        </mxCell>

        <!-- TABLE 2: PERSONAS -->
        <mxCell id="tbl_personas" value="&lt;b style=&quot;font-size: 15px; color: #5F3DC4;&quot;&gt;personas (Pen Names)&lt;/b&gt;&lt;hr style=&quot;border: 0; border-top: 1px solid #B197FC; margin: 4px 0;&quot;&gt;&lt;div style=&quot;text-align: left; font-family: monospace; font-size: 11px; line-height: 1.6; color: #212529;&quot;&gt;&lt;b style=&quot;color: #E03131;&quot;&gt;🔑 id&lt;/b&gt; : SERIAL (PK)&lt;br&gt;&lt;b style=&quot;color: #1971C2;&quot;&gt;🔗 user_id&lt;/b&gt; : INT (FK → users)&lt;br&gt;&lt;b&gt;• display_name&lt;/b&gt; : VARCHAR(100)&lt;br&gt;&lt;b&gt;• handle&lt;/b&gt; : VARCHAR(50) [UQ]&lt;br&gt;&lt;b&gt;• bio&lt;/b&gt; : TEXT&lt;br&gt;&lt;b&gt;• avatar_url&lt;/b&gt; : TEXT&lt;br&gt;&lt;b&gt;• banner_url&lt;/b&gt; : TEXT&lt;br&gt;&lt;b&gt;• is_default&lt;/b&gt; : BOOLEAN&lt;br&gt;&lt;b&gt;• created_at&lt;/b&gt; : TIMESTAMP&lt;br&gt;&lt;b&gt;• deleted_at&lt;/b&gt; : TIMESTAMP&lt;br&gt;&lt;span style=&quot;color: #5F3DC4;&quot;&gt;⭐ UQ(user_id) WHERE default&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F0FF;strokeColor=#7048E8;strokeWidth=2;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="410" y="460" width="250" height="260" as="geometry" />
        </mxCell>

        <!-- TABLE 3: BOOKS -->
        <mxCell id="tbl_books" value="&lt;b style=&quot;font-size: 15px; color: #E67700;&quot;&gt;books (Novels)&lt;/b&gt;&lt;hr style=&quot;border: 0; border-top: 1px solid #FFE066; margin: 4px 0;&quot;&gt;&lt;div style=&quot;text-align: left; font-family: monospace; font-size: 11px; line-height: 1.6; color: #212529;&quot;&gt;&lt;b style=&quot;color: #E03131;&quot;&gt;🔑 id&lt;/b&gt; : SERIAL (PK)&lt;br&gt;&lt;b style=&quot;color: #5F3DC4;&quot;&gt;🔗 persona_id&lt;/b&gt; : INT (FK → personas)&lt;br&gt;&lt;b&gt;• title&lt;/b&gt; : VARCHAR(255)&lt;br&gt;&lt;b&gt;• slug&lt;/b&gt; : VARCHAR(255) [UQ]&lt;br&gt;&lt;b&gt;• description&lt;/b&gt; : TEXT&lt;br&gt;&lt;b&gt;• cover_image&lt;/b&gt; : TEXT&lt;br&gt;&lt;b&gt;• status&lt;/b&gt; : ongoing | completed&lt;br&gt;&lt;b&gt;• is_featured&lt;/b&gt; : BOOLEAN&lt;br&gt;&lt;b&gt;• badge&lt;/b&gt; : VARCHAR(50)&lt;br&gt;&lt;b&gt;• views_count&lt;/b&gt; : INTEGER&lt;br&gt;&lt;b&gt;• tags&lt;/b&gt; : TEXT[]&lt;br&gt;&lt;b&gt;• created_at / deleted_at&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#F08C00;strokeWidth=2;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="740" y="460" width="260" height="280" as="geometry" />
        </mxCell>

        <!-- TABLE 4: VOLUMES -->
        <mxCell id="tbl_volumes" value="&lt;b style=&quot;font-size: 15px; color: #0B7285;&quot;&gt;volumes (Story Arcs)&lt;/b&gt;&lt;hr style=&quot;border: 0; border-top: 1px solid #66D9E8; margin: 4px 0;&quot;&gt;&lt;div style=&quot;text-align: left; font-family: monospace; font-size: 11px; line-height: 1.6; color: #212529;&quot;&gt;&lt;b style=&quot;color: #E03131;&quot;&gt;🔑 id&lt;/b&gt; : SERIAL (PK)&lt;br&gt;&lt;b style=&quot;color: #E67700;&quot;&gt;🔗 book_id&lt;/b&gt; : INT (FK → books)&lt;br&gt;&lt;b&gt;• volume_number&lt;/b&gt; : INTEGER&lt;br&gt;&lt;b&gt;• title&lt;/b&gt; : VARCHAR(255)&lt;br&gt;&lt;b&gt;• description&lt;/b&gt; : TEXT&lt;br&gt;&lt;b&gt;• cover_image&lt;/b&gt; : TEXT&lt;br&gt;&lt;b&gt;• created_at&lt;/b&gt; : TIMESTAMP&lt;br&gt;&lt;b&gt;• deleted_at&lt;/b&gt; : TIMESTAMP&lt;br&gt;&lt;span style=&quot;color: #0B7285;&quot;&gt;⭐ UNIQUE(book_id, vol_num)&lt;/span&gt;&lt;br&gt;&lt;i&gt;📖 Custom Arc Blurbs &amp;amp; Art&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FAFC;strokeColor=#0C8599;strokeWidth=2;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1080" y="460" width="260" height="280" as="geometry" />
        </mxCell>

        <!-- TABLE 5: CHAPTERS -->
        <mxCell id="tbl_chapters" value="&lt;b style=&quot;font-size: 15px; color: #2B8A3E;&quot;&gt;chapters (Manuscript)&lt;/b&gt;&lt;hr style=&quot;border: 0; border-top: 1px solid #8CE99A; margin: 4px 0;&quot;&gt;&lt;div style=&quot;text-align: left; font-family: monospace; font-size: 11px; line-height: 1.6; color: #212529;&quot;&gt;&lt;b style=&quot;color: #E03131;&quot;&gt;🔑 id&lt;/b&gt; : SERIAL (PK)&lt;br&gt;&lt;b style=&quot;color: #E67700;&quot;&gt;🔗 book_id&lt;/b&gt; : INT (FK → books)&lt;br&gt;&lt;b style=&quot;color: #0B7285;&quot;&gt;🔗 volume_id&lt;/b&gt; : INT (FK → volumes)&lt;br&gt;&lt;b&gt;• chapter_number&lt;/b&gt; : INTEGER&lt;br&gt;&lt;b&gt;• title&lt;/b&gt; : VARCHAR(255)&lt;br&gt;&lt;b&gt;• content&lt;/b&gt; : TEXT (Body)&lt;br&gt;&lt;b&gt;• words_count&lt;/b&gt; : INTEGER&lt;br&gt;&lt;b&gt;• status&lt;/b&gt; : draft | published&lt;br&gt;&lt;b&gt;• published_at&lt;/b&gt; : TIMESTAMP&lt;br&gt;&lt;span style=&quot;color: #2B8A3E;&quot;&gt;⭐ UNIQUE(book_id, chap_num)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBFBEE;strokeColor=#2F9E44;strokeWidth=2;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1420" y="460" width="280" height="290" as="geometry" />
        </mxCell>

        <!-- 5-Tier Connecting Arrows -->
        <mxCell id="rel_u_to_p" value="&lt;b&gt;1 : N&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#1971C2;" edge="1" parent="1" source="tbl_users" target="tbl_personas">
          <mxGeometry relative="1" as="geometry" />
