        <mxCell id="rel_b_to_v" value="&lt;b&gt;1 : N&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#F08C00;" edge="1" parent="1" source="tbl_books" target="tbl_volumes">
          <mxGeometry relative="1" as="geometry" />
