# ==============================================================================
# DECKLE BACKEND - ENVIRONMENT VARIABLES CONFIGURATION (RENDER / PRODUCTION)
# ==============================================================================

# Server Port (Render automatically sets PORT, defaults to 8000 locally)
PORT=8000
NODE_ENV=production

# Neon Database Connection String (Serverless PostgreSQL)
# Example: postgresql://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require
DATABASE_URL=your_neon_database_connection_url_here

# JWT Authentication Secrets (Use strong random strings in production)
ACCESS_TOKEN_SECRET=your_super_secret_access_token_key_here
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=your_super_secret_refresh_token_key_here
REFRESH_TOKEN_EXPIRY=7d

# Cross-Origin Resource Sharing (Comma-separated list of allowed frontend URLs)
# Example: http://localhost:5173,https://your-frontend.vercel.app
CORS_ORIGIN=http://localhost:5173

# Cloudinary (Optional - for future image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
