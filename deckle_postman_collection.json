{
  "info": {
    "_postman_id": "deckle-api-v1-collection",
    "name": "Deckle API Collection",
    "description": "Complete Postman collection for all existing endpoints of the Deckle Webnovel & Reader platform.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api/v1",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "00 System & Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8000/api/health",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "health"]
            },
            "description": "Pings the server to verify Express is up and running."
          },
          "response": []
        }
      ]
    },
    {
      "name": "01 Users & Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Alex Johnson\",\n  \"username\": \"alex_writer\",\n  \"email\": \"alex@example.com\",\n  \"password\": \"mySecurePassword123\",\n  \"role\": \"writer\",\n  \"gender\": \"male\",\n  \"dob\": \"2000-05-15\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/register",
              "host": ["{{baseUrl}}"],
              "path": ["users", "register"]
            },
            "description": "Registers a new user and automatically creates their default primary Persona."
          },
          "response": []
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data && jsonData.data.accessToken) {",
                  "        pm.collectionVariables.set('accessToken', jsonData.data.accessToken);",
                  "        console.log('accessToken automatically saved into collection variable!');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alex@example.com\",\n  \"password\": \"mySecurePassword123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/login",
              "host": ["{{baseUrl}}"],
              "path": ["users", "login"]
            },
            "description": "Authenticates the user, sets accessToken & refreshToken cookies, and auto-saves token for Postman."
          },
          "response": []
        },
        {
          "name": "Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/current-user",
              "host": ["{{baseUrl}}"],
              "path": ["users", "current-user"]
            },
            "description": "Fetches currently authenticated user account and their list of personas."
          },
          "response": []
        },
        {
          "name": "Refresh Access Token",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/refresh-token",
              "host": ["{{baseUrl}}"],
              "path": ["users", "refresh-token"]
            },
            "description": "Refreshes expired access token using refreshToken cookie."
          },
          "response": []
        },
        {
          "name": "Change Password",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"oldPassword\": \"mySecurePassword123\",\n  \"newPassword\": \"newSecurePassword456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/change-password",
              "host": ["{{baseUrl}}"],
              "path": ["users", "change-password"]
            },
            "description": "Updates user password after verifying old password."
          },
          "response": []
        },
        {
          "name": "Update Account Info",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Alex Johnson Updated\",\n  \"email\": \"alex.new@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/update-account",
              "host": ["{{baseUrl}}"],
              "path": ["users", "update-account"]
            },
            "description": "Updates full name or email of the current account."
          },
          "response": []
        },
        {
          "name": "Logout User",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/logout",
              "host": ["{{baseUrl}}"],
              "path": ["users", "logout"]
            },
            "description": "Clears DB refreshToken and expires auth cookies."
          },
          "response": []
        }
      ]
    },
    {
