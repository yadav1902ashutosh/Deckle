          },
          "response": []
        },
        {
          "name": "Delete Persona",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/personas/2",
              "host": ["{{baseUrl}}"],
              "path": ["personas", "2"]
            },
            "description": "Soft deletes a persona owned by the user (cannot delete default persona)."
          },
          "response": []
        }
      ]
    },
